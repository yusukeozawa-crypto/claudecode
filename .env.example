# ============================================================
# ローカル実行用の環境変数テンプレート
#   cp .env.example .env して値を設定する (.env は Git にコミットしない)
#   CI では GitHub Secrets から同名の環境変数を渡す
# ============================================================

# 対象環境: local | staging | production
QA_ENV=local

# 検査対象 URL (config/environments.yml から参照される)
# LP ドメイン
#   例) STAGING_BASE_URL=https://lp.littlefamily-ssi-stg.com
#       PRODUCTION_BASE_URL=https://lp.littlefamily-ssi.com
STAGING_BASE_URL=
PRODUCTION_BASE_URL=
# 申込ドメイン (LP とは別ドメイン)
STAGING_APPLICATION_BASE_URL=
PRODUCTION_APPLICATION_BASE_URL=

# ステージングに Basic 認証がある場合のみ設定。
#   対応しているのは「Basic 認証」= サイトを開いた瞬間にブラウザ自身の
#   小さなポップアップで ID / パスワードを聞かれる方式。
#   ここに書けば自動でログインして検査します
#   (ページ表示・リンク検査の双方に適用されます)。
#
#   サイト内の HTML のログインフォーム (メールアドレス+パスワードを
#   ページ内のフォームに入力する方式) は別物で、現時点では未対応です。
#
#   LP ドメインと申込ドメインで ID / パスワードが異なる場合も未対応です
#   (同一なら両方に適用されます)。
#
#   設定を忘れた場合は素通りせず、検査がエラーで停止します。
STAGING_BASIC_USER=
STAGING_BASIC_PASS=

# AI による文章チェックを後から有効化する場合のみ設定
QA_AI_API_KEY=

# ローカル環境でシステム側の Chromium を使う場合のみ設定 (通常は不要)
# QA_CHROMIUM_EXECUTABLE=/opt/pw-browsers/chromium
