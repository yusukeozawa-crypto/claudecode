{
  "name": "web-release-qa",
  "version": "1.0.0",
  "private": true,
  "description": "Webサイト公開後の自動QAツール (Playwright + TypeScript)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "agencies:build": "node scripts/build-agencies.mjs",
    "clean": "node scripts/clean.mjs",
    "discover": "node scripts/with-env.mjs QA_DISCOVER=1 -- playwright test --grep @discover --project=*-pc --reporter=list",
    "discover:production": "node scripts/with-env.mjs QA_ENV=production QA_DISCOVER=1 -- playwright test --grep @discover --project=*-pc --reporter=list",
    "discover:staging": "node scripts/with-env.mjs QA_ENV=staging QA_DISCOVER=1 -- playwright test --grep @discover --project=*-pc --reporter=list",
    "findings": "node scripts/show-findings.mjs",
    "gate": "node scripts/gate.mjs",
    "mock:serve": "node fixtures/mock-site/server.mjs",
    "mock:serve:application": "node fixtures/mock-site/application-server.mjs",
    "prepare:browsers": "playwright install chromium",
    "qa": "node scripts/launcher.mjs",
    "report": "node scripts/serve-report.mjs",
    "test": "playwright test",
    "test:agency": "playwright test --grep @agency",
    "test:agency:all": "node scripts/with-env.mjs QA_AGENCY_SCOPE=all -- playwright test --grep @agency",
    "test:all-agencies": "node scripts/with-env.mjs QA_AGENCY_SCOPE=all -- playwright test",
    "test:crawl": "playwright test --grep @crawl",
    "test:handoff": "playwright test --grep @handoff",
    "test:health": "playwright test --grep @health",
    "test:local": "playwright test --grep-invert @visual",
    "test:local:staging": "node scripts/with-env.mjs QA_ENV=staging -- playwright test --grep-invert @visual",
    "test:pc": "playwright test --project=*-pc",
    "test:production": "node scripts/with-env.mjs QA_ENV=production -- playwright test",
    "test:redirect": "playwright test --grep @redirect",
    "test:security": "playwright test --grep @security",
    "test:sp": "playwright test --project=*-sp",
    "test:staging": "node scripts/with-env.mjs QA_ENV=staging -- playwright test",
    "test:text": "playwright test --grep @text",
    "test:visual": "playwright test --grep @visual",
    "typecheck": "tsc --noEmit",
    "update": "node scripts/update.mjs",
    "update:screenshots": "node scripts/update-baselines.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "yaml": "^2.6.0"
  }
}
